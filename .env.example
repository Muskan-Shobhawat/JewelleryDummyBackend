PORT=4000
NODE_ENV=development
# Comma separated list of allowed frontend origins. Any localhost port is also allowed when NODE_ENV is not production.
CORS_ORIGIN=http://localhost:3000

# Auth
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=30d
# Demo mode: OTP is always DEMO_OTP and is also returned by /auth/send-otp
DEMO_MODE=true
DEMO_OTP=123456

# Admin API key for /api/admin/* (used by the separate admin panel later)
ADMIN_API_KEY=admin-demo-key

# Live rate simulator: how often the rate ticks (seconds)
RATE_TICK_SECONDS=30

# Where runtime changes are persisted (relative to repo). Delete or run `npm run reset` to restore seed data.
STATE_FILE=.data/state.json
